<mujoco model="senecabot_rr">
    <compiler angle="degree" autolimits="true"/>
    
    <!-- OPCIONES FÍSICAS -->
    <option cone="elliptic" impratio="100" timestep="0.002"/>

    <visual>
        <global offwidth="3840" offheight="2160"/>
    </visual>

    <include file="scene.xml"/>
    <include file="mimic_sites.xml"/>

    <!-- DEFAULTS JERÁRQUICOS -->
    <default>
        <default class="senecabot">
            <geom friction="0.6" margin="0.001" condim="1" group="0"/>
            <joint damping="1.5" armature="0.01" frictionloss="0.2"/>
            
            <motor ctrllimited="true"/>

            <default class="hip">
                <joint type="hinge" axis="0 1 0"/>
                </default>
            <default class="knee">
                <joint type="hinge" axis="0 -1 0"/>
                </default>
            <default class="ankle">
                <joint type="hinge" axis="0 1 0" damping="0.05"/> </default>
            <default class="foot">
                <geom priority="1" solimp="0.015 1 0.022" condim="6" friction="0.8 0.02 0.01"/>
            </default>
        </default>
    </default>

    <!-- RR VARIANT of senecabot_loco.xml, generated by geometry_opt/make_rr_xml.py (do not edit by hand).
         The first link of every leg (thigh `*_upper`, hip joint and hip actuator) is removed, leaving a 2R leg: tibia
         `*_lower` (knee joint) + metatarsus `*_foot` (ankle joint), unchanged in length, geometry, masses, joint axes,
         ranges and damping. The knee pivot is fixed to the torso where the knee was with the hip at 0
         ((upper pos) + (0, 0, -thigh length)); every body/joint/site name is kept (`*_thigh_mimic` now sits on the torso at
         the knee pivot). The tibia pitch is now the knee angle alone (hip - knee with hip = 0): policies trained on
         the RRR model do NOT transfer, the gait has to be retrained.
         With the linkage: each leg carries the RR 1 (`*_rr1_l1`, `*_rr1_l2`) and RR 2 (`*_rr2_l3`, `*_rr2_l4`) bar mechanisms of geometry_opt/linkage.py, closed on the tibia and the metatarsus by `connect` equalities; the two crank hinges `*_rr1_joint`, `*_rr2_joint` are the only actuated joints (motors `*_rr1`, `*_rr2`), the knee and ankle are passive. qpos0 is the closed reference pose (centre of the range of motion, joint `ref`). Bars are capsules as wide as the link they drive; mounting plates `*_mount_*` are visual only. Design: policy v140. -->

    <!-- LEG SEGMENT NAMING.
         This is a SIMPLIFIED quadruped: all four legs are identical 3-DOF serial
         chains, so the segment bodies use generic proximal->distal names
         (upper / lower / foot) rather than per-limb anatomy. A real ovine forelimb
         (humerus / forearm / metacarpus, joints shoulder-elbow-carpus) and hindlimb
         (femur / tibia / metatarsus, joints hip-stifle-hock) are NOT the same; one
         uniform anatomical scheme cannot be correct for both, so we stay generic.
         The hip/knee/ankle joint names are likewise functional, not anatomical.
         NOTE: the mimic SITE names (*_thigh_mimic, *_shank_mimic, *_foot_mimic) keep
         their legacy words on purpose — they are referenced by name in
         simulation/config/pipeline.py (SITE_NAMES) and the fork env senecabot.py, so
         renaming them would break the trained pipeline. Body<->site word mismatch
         (e.g. body "fr_upper" holds site "fr_thigh_mimic") is expected. -->
    <worldbody>
        <body name="base" pos="0 0 0.4" childclass="senecabot">
            
            <camera name="follow" mode="track" target="base" pos="1 -1 0" xyaxes="0.707 0.707 0 0 0 1"/> <!-- EAST-->
            <camera name="follow_west" mode="track" target="base" pos="1 1 0" xyaxes="-0.707 0.707 0 0 0 1"/>
            <freejoint name="root"/>
            <geom type="box" size="0.21 0.12 0.06" mass="3" rgba="0.8 0.6 0.4 1"/>
            
            <site name="base_mimic" class="mimic" pos="0 0 0" size="0.01"/>

            <!-- ================= Pata Delantera Derecha (FR) ================= -->
            <site name="fr_thigh_mimic" class="mimic" pos="0.2 -0.1 -0.058"/>

            <body name="fr_lower" pos="0.2 -0.1 -0.058" euler="0 -57.9687 0">
                    <joint name="fr_knee_joint" class="knee" range="34 150" ref="57.9687"/>
                    <geom type="capsule" fromto="0 0 0 0 0 -0.111" size="0.025" rgba="0.3 0.3 0.3 1"/>
                    <site name="fr_shank_mimic" class="mimic" pos="0 0 -0.111"/>

                    <body name="fr_foot" pos="0 0 -0.111" euler="0 104.753 0">
                        <joint name="fr_ankle_joint" class="ankle" range="0 160" ref="104.753"/>
                        <geom type="capsule" fromto="0 0 0 0 0 -0.1534" size="0.02" rgba="0.4 0.4 0.4 1"/>
                        <geom name="fr_foot" type="sphere" size="0.025" pos="0 0 -0.1534" rgba="0.9 0.1 0.1 1" class="foot"/>
                        
                        <site name="fr_foot" pos="0 0 -0.1534" size="0.01"/>
                        <site name="fr_foot_mimic" class="mimic" pos="0 0 -0.1534" size="0.01"/>
                    </body>
                </body>
            <!-- ===== FR: RR 1 (l1, l2) -> tibia at f1 = 0.50; RR 2 (l3, l4) -> metatarsus at f2 = 0.20 ===== -->
            
            
            
            <site name="fr_rr_B" pos="0.165836 -0.1 -0.0233172" size="0.008" rgba="0 0 0 1"/>
            <body name="fr_rr1_l1" pos="0.165836 -0.1 -0.0233172" euler="0 7.39641 0">
                <joint name="fr_rr1_joint" type="hinge" axis="0 -1 0" ref="-7.39641"/>
                <geom type="capsule" fromto="0 0 0 0.0409066 0 0" size="0.025" rgba="0.95 0.55 0.1 1" mass="0.00892387" contype="0" conaffinity="0"/>
                <body name="fr_rr1_l2" pos="0.0409066 0 0" euler="0 47.9716 0">
                    <joint name="fr_rr1_elbow" type="hinge" axis="0 -1 0" ref="-47.9716" damping="0.01" armature="0.001" frictionloss="0"/>
                    <geom type="capsule" fromto="0 0 0 0.0715261 0 0" size="0.025" rgba="0.95 0.55 0.1 1" mass="0.0156036" contype="0" conaffinity="0"/>
                </body>
            </body>
            <body name="fr_rr2_l3" pos="0.2 -0.1 -0.058" euler="0 134.734 0">
                <joint name="fr_rr2_joint" type="hinge" axis="0 -1 0" ref="-134.734"/>
                <geom type="capsule" fromto="0 0 0 0.032977 0 0" size="0.02" rgba="0.85 0.2 0.2 1" mass="0.007194" contype="0" conaffinity="0"/>
                <body name="fr_rr2_l4" pos="0.032977 0 0" euler="0 -104 0">
                    <joint name="fr_rr2_elbow" type="hinge" axis="0 -1 0" ref="104" damping="0.01" armature="0.001" frictionloss="0"/>
                    <geom type="capsule" fromto="0 0 0 0.110467 0 0" size="0.02" rgba="0.85 0.2 0.2 1" mass="0.0240985" contype="0" conaffinity="0"/>
                </body>
            </body>
            

            <!-- ================= Pata Delantera Izquierda (FL) ================= -->
            <site name="fl_thigh_mimic" class="mimic" pos="0.2 0.1 -0.058"/>

            <body name="fl_lower" pos="0.2 0.1 -0.058" euler="0 -57.9687 0">
                    <joint name="fl_knee_joint" class="knee" range="34 150" ref="57.9687"/>
                    <geom type="capsule" fromto="0 0 0 0 0 -0.111" size="0.025" rgba="0.3 0.3 0.3 1"/>
                    <site name="fl_shank_mimic" class="mimic" pos="0 0 -0.111"/>

                    <body name="fl_foot" pos="0 0 -0.111" euler="0 104.753 0">
                        <joint name="fl_ankle_joint" class="ankle" range="0 160" ref="104.753"/>
                        <geom type="capsule" fromto="0 0 0 0 0 -0.1534" size="0.02" rgba="0.4 0.4 0.4 1"/>
                        <geom name="fl_foot" type="sphere" size="0.025" pos="0 0 -0.1534" rgba="0.9 0.1 0.1 1" class="foot"/>
                        
                        <site name="fl_foot" pos="0 0 -0.1534" size="0.01"/>
                        <site name="fl_foot_mimic" class="mimic" pos="0 0 -0.1534" size="0.01"/>
                    </body>
                </body>
            <!-- ===== FL: RR 1 (l1, l2) -> tibia at f1 = 0.50; RR 2 (l3, l4) -> metatarsus at f2 = 0.20 ===== -->
            
            
            
            <site name="fl_rr_B" pos="0.165836 0.1 -0.0233172" size="0.008" rgba="0 0 0 1"/>
            <body name="fl_rr1_l1" pos="0.165836 0.1 -0.0233172" euler="0 7.39641 0">
                <joint name="fl_rr1_joint" type="hinge" axis="0 -1 0" ref="-7.39641"/>
                <geom type="capsule" fromto="0 0 0 0.0409066 0 0" size="0.025" rgba="0.95 0.55 0.1 1" mass="0.00892387" contype="0" conaffinity="0"/>
                <body name="fl_rr1_l2" pos="0.0409066 0 0" euler="0 47.9716 0">
                    <joint name="fl_rr1_elbow" type="hinge" axis="0 -1 0" ref="-47.9716" damping="0.01" armature="0.001" frictionloss="0"/>
                    <geom type="capsule" fromto="0 0 0 0.0715261 0 0" size="0.025" rgba="0.95 0.55 0.1 1" mass="0.0156036" contype="0" conaffinity="0"/>
                </body>
            </body>
            <body name="fl_rr2_l3" pos="0.2 0.1 -0.058" euler="0 134.734 0">
                <joint name="fl_rr2_joint" type="hinge" axis="0 -1 0" ref="-134.734"/>
                <geom type="capsule" fromto="0 0 0 0.032977 0 0" size="0.02" rgba="0.85 0.2 0.2 1" mass="0.007194" contype="0" conaffinity="0"/>
                <body name="fl_rr2_l4" pos="0.032977 0 0" euler="0 -104 0">
                    <joint name="fl_rr2_elbow" type="hinge" axis="0 -1 0" ref="104" damping="0.01" armature="0.001" frictionloss="0"/>
                    <geom type="capsule" fromto="0 0 0 0.110467 0 0" size="0.02" rgba="0.85 0.2 0.2 1" mass="0.0240985" contype="0" conaffinity="0"/>
                </body>
            </body>
            

            <!-- ================= Pata Trasera Derecha (BR) ================= -->
            <site name="br_thigh_mimic" class="mimic" pos="-0.17326 -0.1 0.0226"/>

            <body name="br_lower" pos="-0.17326 -0.1 0.0226" euler="0 62.1605 0">
                    <joint name="br_knee_joint" class="knee" range="-140 -40" ref="-62.1605"/>
                    <geom type="capsule" fromto="0 0 0 0 0 -0.231" size="0.025" rgba="0.3 0.3 0.3 1"/>
                    <site name="br_shank_mimic" class="mimic" pos="0 0 -0.231"/>

                    <body name="br_foot" pos="0 0 -0.231" euler="0 -59.4591 0">
                        <joint name="br_ankle_joint" class="ankle" range="-85 0" ref="-59.4591"/>
                        <geom type="capsule" fromto="0 0 0 0 0 -0.148" size="0.02" rgba="0.4 0.4 0.4 1"/>
                        <geom name="br_foot" type="sphere" size="0.025" pos="0 0 -0.148" rgba="0.9 0.1 0.1 1" class="foot"/>
                        
                        <site name="br_foot" pos="0 0 -0.148" size="0.01"/>
                        <site name="br_foot_mimic" class="mimic" pos="0 0 -0.148" size="0.01"/>
                    </body>
                </body>
            <!-- ===== BR: RR 1 (l1, l2) -> tibia at f1 = 0.30; RR 2 (l3, l4) -> metatarsus at f2 = 0.50 ===== -->
            
            
            
            <site name="br_rr_B" pos="-0.208 -0.1 0.0573228" size="0.008" rgba="0 0 0 1"/>
            <body name="br_rr1_l1" pos="-0.208 -0.1 0.0573228" euler="0 33.4907 0">
                <joint name="br_rr1_joint" type="hinge" axis="0 -1 0" ref="-33.4907"/>
                <geom type="capsule" fromto="0 0 0 0.0307072 0 0" size="0.025" rgba="0.95 0.55 0.1 1" mass="0.00669884" contype="0" conaffinity="0"/>
                <body name="br_rr1_l2" pos="0.0307072 0 0" euler="0 102.633 0">
                    <joint name="br_rr1_elbow" type="hinge" axis="0 -1 0" ref="-102.633" damping="0.01" armature="0.001" frictionloss="0"/>
                    <geom type="capsule" fromto="0 0 0 0.0723433 0 0" size="0.025" rgba="0.95 0.55 0.1 1" mass="0.0157819" contype="0" conaffinity="0"/>
                </body>
            </body>
            <body name="br_rr2_l3" pos="-0.17326 -0.1 0.0226" euler="0 117.399 0">
                <joint name="br_rr2_joint" type="hinge" axis="0 -1 0" ref="-117.399"/>
                <geom type="capsule" fromto="0 0 0 0.209518 0 0" size="0.02" rgba="0.85 0.2 0.2 1" mass="0.0457069" contype="0" conaffinity="0"/>
                <body name="br_rr2_l4" pos="0.209518 0 0" euler="0 -295.228 0">
                    <joint name="br_rr2_elbow" type="hinge" axis="0 -1 0" ref="295.228" damping="0.01" armature="0.001" frictionloss="0"/>
                    <geom type="capsule" fromto="0 0 0 0.111413 0 0" size="0.02" rgba="0.85 0.2 0.2 1" mass="0.0243051" contype="0" conaffinity="0"/>
                </body>
            </body>
            

            <!-- ================= Pata Trasera Izquierda (BL) ================= -->
            <site name="bl_thigh_mimic" class="mimic" pos="-0.17326 0.1 0.0226"/>

            <body name="bl_lower" pos="-0.17326 0.1 0.0226" euler="0 62.1605 0">
                    <joint name="bl_knee_joint" class="knee" range="-140 -40" ref="-62.1605"/>
                    <geom type="capsule" fromto="0 0 0 0 0 -0.231" size="0.025" rgba="0.3 0.3 0.3 1"/>
                    <site name="bl_shank_mimic" class="mimic" pos="0 0 -0.231"/>

                    <body name="bl_foot" pos="0 0 -0.231" euler="0 -59.4591 0">
                        <joint name="bl_ankle_joint" class="ankle" range="-85 0" ref="-59.4591"/>
                        <geom type="capsule" fromto="0 0 0 0 0 -0.148" size="0.02" rgba="0.4 0.4 0.4 1"/>
                        <geom name="bl_foot" type="sphere" size="0.025" pos="0 0 -0.148" rgba="0.9 0.1 0.1 1" class="foot"/>
                        
                        <site name="bl_foot" pos="0 0 -0.148" size="0.01"/>
                        <site name="bl_foot_mimic" class="mimic" pos="0 0 -0.148" size="0.01"/>
                    </body>
                </body>
            <!-- ===== BL: RR 1 (l1, l2) -> tibia at f1 = 0.30; RR 2 (l3, l4) -> metatarsus at f2 = 0.50 ===== -->
            
            
            
            <site name="bl_rr_B" pos="-0.208 0.1 0.0573228" size="0.008" rgba="0 0 0 1"/>
            <body name="bl_rr1_l1" pos="-0.208 0.1 0.0573228" euler="0 33.4907 0">
                <joint name="bl_rr1_joint" type="hinge" axis="0 -1 0" ref="-33.4907"/>
                <geom type="capsule" fromto="0 0 0 0.0307072 0 0" size="0.025" rgba="0.95 0.55 0.1 1" mass="0.00669884" contype="0" conaffinity="0"/>
                <body name="bl_rr1_l2" pos="0.0307072 0 0" euler="0 102.633 0">
                    <joint name="bl_rr1_elbow" type="hinge" axis="0 -1 0" ref="-102.633" damping="0.01" armature="0.001" frictionloss="0"/>
                    <geom type="capsule" fromto="0 0 0 0.0723433 0 0" size="0.025" rgba="0.95 0.55 0.1 1" mass="0.0157819" contype="0" conaffinity="0"/>
                </body>
            </body>
            <body name="bl_rr2_l3" pos="-0.17326 0.1 0.0226" euler="0 117.399 0">
                <joint name="bl_rr2_joint" type="hinge" axis="0 -1 0" ref="-117.399"/>
                <geom type="capsule" fromto="0 0 0 0.209518 0 0" size="0.02" rgba="0.85 0.2 0.2 1" mass="0.0457069" contype="0" conaffinity="0"/>
                <body name="bl_rr2_l4" pos="0.209518 0 0" euler="0 -295.228 0">
                    <joint name="bl_rr2_elbow" type="hinge" axis="0 -1 0" ref="295.228" damping="0.01" armature="0.001" frictionloss="0"/>
                    <geom type="capsule" fromto="0 0 0 0.111413 0 0" size="0.02" rgba="0.85 0.2 0.2 1" mass="0.0243051" contype="0" conaffinity="0"/>
                </body>
            </body>
            
        </body>
    </worldbody>

    <!-- EXCLUSIONES DE CONTACTO (Sin cambios, usa los nombres de los bodies) -->
    <contact>
        <exclude body1="base" body2="fr_lower"/>
        <exclude body1="base" body2="fr_foot"/>
        <exclude body1="base" body2="fl_lower"/>
        <exclude body1="base" body2="fl_foot"/>
        <exclude body1="base" body2="br_lower"/>
        <exclude body1="base" body2="br_foot"/>
        <exclude body1="base" body2="bl_lower"/>
        <exclude body1="base" body2="bl_foot"/>
    </contact>

    <!-- ACTUADORES: Nombres limpios para el código de Python -->
    <actuator>
            <motor name="fr_rr1" joint="fr_rr1_joint" ctrlrange="-120 120"/>
        <motor name="fr_rr2" joint="fr_rr2_joint" ctrlrange="-32 32"/>
        <motor name="fl_rr1" joint="fl_rr1_joint" ctrlrange="-120 120"/>
        <motor name="fl_rr2" joint="fl_rr2_joint" ctrlrange="-32 32"/>
        <motor name="br_rr1" joint="br_rr1_joint" ctrlrange="-120 120"/>
        <motor name="br_rr2" joint="br_rr2_joint" ctrlrange="-120 120"/>
        <motor name="bl_rr1" joint="bl_rr1_joint" ctrlrange="-120 120"/>
        <motor name="bl_rr2" joint="bl_rr2_joint" ctrlrange="-120 120"/>
    </actuator>
    <!-- Closed loops of the two RR mechanisms: the tip of l2 / l4 is pinned to the tibia / metatarsus -->
    <equality>
        <connect name="fr_rr1_loop" body1="fr_rr1_l2" body2="fr_lower" anchor="0.0715261 0 0"/>
        <connect name="fr_rr2_loop" body1="fr_rr2_l4" body2="fr_foot" anchor="0.110467 0 0"/>
        <connect name="fl_rr1_loop" body1="fl_rr1_l2" body2="fl_lower" anchor="0.0715261 0 0"/>
        <connect name="fl_rr2_loop" body1="fl_rr2_l4" body2="fl_foot" anchor="0.110467 0 0"/>
        <connect name="br_rr1_loop" body1="br_rr1_l2" body2="br_lower" anchor="0.0723433 0 0"/>
        <connect name="br_rr2_loop" body1="br_rr2_l4" body2="br_foot" anchor="0.111413 0 0"/>
        <connect name="bl_rr1_loop" body1="bl_rr1_l2" body2="bl_lower" anchor="0.0723433 0 0"/>
        <connect name="bl_rr2_loop" body1="bl_rr2_l4" body2="bl_foot" anchor="0.111413 0 0"/>
    </equality>
</mujoco>